# true = только проверенный пример редакций 8 и 9; false = ваши документы и AI API
DEMO_MODE=true
AI_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
# Выберите доступную вам модель с контекстом от 64k и поддержкой JSON.
AI_MODEL=
AI_TIMEOUT_MS=90000

# Required for paid AI when NODE_ENV=production. Use a random secret (16+ characters).
# Leave DEMO_MODE=true for a public demonstration without AI charges.
APP_ACCESS_CODE=
# Shared per server process; resets on restart. Multi-instance hosting needs a shared limiter.
ANALYSIS_HOURLY_LIMIT=3
ASSISTANT_HOURLY_LIMIT=30
